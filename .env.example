# GridPilot personal profile
APP_NAME=GridPilot
OWNER_NAME=个人版
PORT=8080
HOST=127.0.0.1

# Paper mode is the default and never sends real orders.
TRADING_MODE=paper
PAPER_BALANCE=10000
DECIBEL_NETWORK=mainnet
DECIBEL_API_KEY=
DECIBEL_API_URL=
DECIBEL_ORIGIN=http://127.0.0.1
DECIBEL_PROXY=

# Live mode has a deliberate three-part gate. Keep these disabled for paper use.
ENABLE_LIVE_TRADING=false
LIVE_CONFIRMATION=
DECIBEL_PRIVATE_KEY=
DECIBEL_SUBACCOUNT=

# Resume a running grid from .state.json after restart.
AUTO_RESUME=true

# Live risk guard. Raise limits only after small-size verification.
REQUIRE_FRESH_PREFLIGHT=true
LIVE_MAX_LEVERAGE=10
LIVE_MAX_GRID_COUNT=0
LIVE_MAX_NOTIONAL=0
LIVE_MAX_MARGIN_PCT=35
LIVE_MIN_MAINTENANCE_RATIO=300
LIVE_DAILY_LOSS_LIMIT=20
LIVE_MAX_DRAWDOWN_PCT=30

# Optional alerts. Configure Telegram or a generic JSON webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=

# Required when HOST is not 127.0.0.1/localhost. Open the UI with ?token=YOUR_TOKEN.
DASHBOARD_TOKEN=
