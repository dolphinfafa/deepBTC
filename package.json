{
  "name": "gridpilot-decibel",
  "version": "1.0.0",
  "private": true,
  "description": "GridPilot personal Decibel perpetual grid console with paper-first safety defaults.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/grid.test.js",
    "backtest:btc": "node scripts/backtest-btc.js",
    "fetch:funding": "node scripts/fetch-funding-history.js",
    "backtest:turtle": "node scripts/backtest-turtle.js",
    "backtest:ai-rotation": "node scripts/backtest-ai-rotation.js",
    "backtest:ai-rotation:train": "BACKTEST_RESEARCH_STAGE=train node scripts/backtest-ai-rotation.js",
    "backtest:ai-rotation:validate": "BACKTEST_RESEARCH_STAGE=validate node scripts/backtest-ai-rotation.js",
    "backtest:ai-rotation:v3": "BACKTEST_RESEARCH_STAGE=v3 node scripts/backtest-ai-rotation.js",
    "backtest:long-scale": "BACKTEST_DAYS=1095 BACKTEST_RESEARCH_STAGE=long_scale node scripts/backtest-ai-rotation.js",
    "backtest:ai-rotation:robustness": "BACKTEST_DAYS=1825 BACKTEST_RESEARCH_STAGE=robustness node scripts/backtest-ai-rotation.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@decibeltrade/sdk": "0.7.0",
    "undici": "^6.19.8"
  }
}
